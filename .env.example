# SHARMA GLOBAL LLC website — environment variables
#
# NOTE: the contact form no longer uses an environment variable.
# Its delivery endpoint lives in src/config/company.ts
# (`contactFormEndpoint`) so the form also works on static hosting
# like GitHub Pages, where messages are sent directly from the
# visitor's browser to FormSubmit.co.
#
# This file is kept for future server-side integrations. Copy it to
# .env.local and never commit .env.local.
# ──────────────────────────────────────────────────────────────────
